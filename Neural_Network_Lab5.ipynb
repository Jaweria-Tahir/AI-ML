   "source": [
    "#using sympy to find derivative\n",
    "\n",
    "import sympy as smp\n",
    "J,w=smp.symbols('J,w')\n",
    "J=w**2\n",
    "dj=smp.diff(J,w)\n",
    "dj.subs([(w,2)])"
   ]
  },
